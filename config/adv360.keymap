#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ja_n2: ja_number_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_n6: ja_number_6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_6>, <&kp EQUAL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_n7: ja_number_7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp NUMBER_6>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_n8: ja_number_8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp SINGLE_QUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_n9: ja_number_9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp N8>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_n0: ja_number_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp N9>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_minus: ja_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp INTERNATIONAL_1>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_equal: ja_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(MINUS)>, <&kp SEMICOLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_left_bracket: ja_left_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACKET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_right_bracket: ja_right_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp BACKSLASH>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_semi_colon: ja_semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp SINGLE_QUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_quote: ja_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N7)>, <&kp LS(NUMBER_2)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_back_quote: ja_back_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET)>, <&kp LS(EQUAL)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ja_back_slash: ja_back_slash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_1>, <&kp INTERNATIONAL_3>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        macro_ltu: macro_ltu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp T &kp U>;
            label = "MACRO_LTU";
            wait-ms = <0>;
        };

        macro_nn: macro_nn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "MACRO_NN";
        };

        macro_ime_on: macro_ime_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_4 &to 1>;
            label = "MACRO_IME_ON";
        };

        macro_ime_off: macro_ime_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_5 &to 0>;
            label = "MACRO_IME_OFF";
        };

        macro_SANTEN: macro_SANTEN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH &kp FSLH &kp FSLH>;
            label = "MACRO_SANTEN";
        };

        macro_YA: macro_YA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp A>;
            label = "MACRO_YA";
            wait-ms = <0>;
        };

        macro_YU: macro_YU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp U>;
            label = "MACRO_YU";
            wait-ms = <0>;
        };

        macro_YO: macro_YO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp O>;
            label = "MACRO_YO";
            wait-ms = <0>;
        };

        macro_LA: macro_LA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp A>;
            label = "MACRO_LA";
        };

        macro_LI: macro_LI {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp I>;
            label = "MACRO_LI";
        };

        macro_LU: macro_LU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp U>;
            label = "MACRO_LU";
        };

        macro_LE: macro_LE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp E>;
            label = "MACRO_LE";
        };

        macro_LO: macro_LO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp O>;
            label = "MACRO_LO";
        };

        macro_LYA: macro_LYA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp Y &kp A>;
            label = "MACRO_LYA";
        };

        macro_LYU: macro_LYU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp Y &kp U>;
            label = "MACRO_LYU";
        };

        macro_LYO: macro_LYO {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp Y &kp O>;
            label = "MACRO_LYO";
        };

        macro_Mac_KANA: macro_Mac_KANA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_1 &to 1>;
            label = "MACRO_MAC_KANA";
        };

        macro_Mac_EISUU: macro_Mac_EISUU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &to 0>;
            label = "MACRO_MAC_EISUU";
        };

        macro_SHIFT: macro_SHIFT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT &sl 0>;
            label = "MACRO_SHIFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp N1          &ja_n2        &kp N3      &kp N4     &kp N5  &tog 3                                                                            &mo 5            &ja_n6  &ja_n7  &ja_n8    &ja_n9            &ja_n0             &ja_minus
&kp TAB           &ja_quote       &kp COMMA     &kp PERIOD  &kp P      &kp Y   &kp INTERNATIONAL_5                                                               &macro_ime_on    &kp F   &kp G   &kp C     &kp R             &kp L              &kp SLASH
&kp LEFT_CONTROL  &kp A           &kp O         &kp E       &kp U      &kp I   &kp LANGUAGE_2       &ja_equal  &kp LALT           &kp LGUI       &ja_back_slash  &macro_Mac_KANA  &kp D   &kp H   &kp T     &kp N             &kp S              &kp RIGHT_CONTROL
&kp LEFT_SHIFT    &ja_semi_colon  &kp Q         &kp J       &kp K      &kp X                                   &kp DELETE         &kp DELETE                                      &kp B   &kp M   &kp W     &kp V             &kp Z              &kp RIGHT_SHIFT
&mo 4             &ja_back_quote  &kp RS(CAPS)  &kp LEFT    &kp RIGHT          &mo 3                &kp SPACE  &kp BACKSPACE      &kp BACKSPACE  &kp ENTER       &mo 3                    &kp UP  &kp DOWN  &ja_left_bracket  &ja_right_bracket  &mo 4
            >;
        };

        Japanese {
            display-name = "Red";
            bindings = <
&kp ESC           &kp N1               &kp N2               &kp N3    &kp N4     &kp N5      &none                                                                                &none                &kp N6         &kp N7      &kp N8     &kp N9             &kp N0         &kp MINUS
&kp TAB           &kp P                &kp R                &kp N     &kp M      &kp COMMA   &macro_ime_off                                                                       &kp INTERNATIONAL_4  &kp SLASH      &macro_ltu  &kp I      &kp E              &kp L          &kp SEMICOLON
&kp LEFT_CONTROL  &kp H                &kp T                &kp S     &kp K      &kp W       &macro_Mac_EISUU  &kp EQUAL  &kp LALT           &kp LGUI       &kp NON_US_BACKSLASH  &kp LANGUAGE_1       &macro_nn      &kp A       &kp U      &kp O              &kp MINUS      &kp RIGHT_CONTROL
&sl 2             &kp B                &kp D                &kp Z     &kp G      &kp PERIOD                               &kp DELETE         &kp DELETE                                                &kp LS(SLASH)  &macro_YA   &macro_YU  &macro_YO          &kp Y          &sl 2
&mo 4             &kp INTERNATIONAL_2  &kp INTERNATIONAL_1  &kp LEFT  &kp RIGHT              &mo 3             &kp SPACE  &kp BACKSPACE      &kp BACKSPACE  &kp ENTER             &mo 3                               &kp UP      &kp DOWN   &kp RIGHT_BRACKET  &kp BACKSLASH  &mo 4
            >;
        };

        JAPANESE_Shift {
            display-name = "Red";
            bindings = <
&kp ESC           &kp LS(N1)           &kp LEFT_BRACKET     &kp LS(N3)  &kp LS(N4)  &kp LS(N5)      &none                                                                             &none  &kp EQUAL          &kp LS(NUMBER_6)  &kp LS(APOSTROPHE)  &kp LS(NUMBER_8)       &kp LS(N9)         &kp LS(INTERNATIONAL_1)
&kp TAB           &none                &none                &none       &none       &kp LS(COMMA)   &none                                                                             &none  &kp LA(SEMICOLON)  &none             &macro_LI           &macro_LE              &none              &kp APOS
&kp LEFT_CONTROL  &kp F                &none                &none       &none       &none           &none  &kp LS(EQUAL)  &kp LALT           &kp LGUI       &kp LS(NON_US_BACKSLASH)  &none  &none              &macro_LA         &macro_LU           &macro_LO              &kp LS(MINUS)      &kp RIGHT_CONTROL
&kp LSHFT         &kp V                &none                &none       &none       &kp LS(PERIOD)                        &kp DELETE         &kp DELETE                                      &kp LS(NUMBER_1)   &macro_LYA        &macro_LYU          &macro_LYO             &none              &kp RSHFT
&mo 0             &kp INTERNATIONAL_2  &kp INTERNATIONAL_1  &kp LEFT    &kp RIGHT                   &none  &kp LS(SPACE)  &kp BACKSPACE      &kp BACKSPACE  &kp ENTER                 &none                     &kp UP            &kp DOWN            &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &mo 0
            >;
        };

        KEYPAD {
            display-name = "Kp";
            bindings = <
&kp ESCAPE        &kp SLASH  &kp MINUS       &kp LS(MINUS)      &kp LS(SEMICOLON)  &kp LS(APOSTROPHE)  &trans                                                     &mo 0   &kp LS(EQUAL)      &kp RIGHT_BRACKET  &kp BACKSLASH    &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)  &none
&kp TAB           &none      &kp PAGE_UP     &kp UP             &kp PAGE_DOWN      &none               &none                                                      &none   &none              &kp PAGE_UP        &kp UP_ARROW     &kp PAGE_DOWN          &none              &none
&kp LEFT_CONTROL  &kp HOME   &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT_ARROW    &kp END             &none   &none    &kp LALT           &kp LGUI    &none      &none   &kp HOME           &kp LEFT_ARROW     &kp DOWN_ARROW   &kp RIGHT_ARROW        &kp END            &kp RIGHT_CONTROL
&kp LSHFT         &kp LC(Z)  &kp LC(X)       &kp LC(C)          &kp LC(V)          &kp LA(SPACE)                        &none              &none                          &kp K_APPLICATION  &kp LC(KP_PLUS)    &kp F17          &kp F18                &none              &kp RSHFT
&mo 0             &none      &none           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP                        &trans  &kp DEL  &kp BACKSPACE      &kp DELETE  &kp ENTER  &trans                     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F22                &kp F23            &mo 0
            >;
        };

        Fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &none                                       &none   &kp F7  &kp F8  &kp F18  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans   &trans   &trans   &trans
            >;
        };

        MOD {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
